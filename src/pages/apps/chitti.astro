---
import Base from '../../layouts/Base.astro';
import Workspace from '../../components/chitti/Workspace';
---
<Base title="Chitti · Amaljith Kuttamath" description="A data analysis workspace. Compare public datasets, chart results, and inspect sources." ogImage="/images/chitti-og.png">
  <Fragment slot="head">
    <link rel="manifest" href="/apps/chitti/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apps/chitti/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Chitti" />
  </Fragment>
  <Workspace client:only="react"><p slot="fallback">Opening Chitti’s data workspace…</p></Workspace>
  <script is:inline>
    if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
      window.addEventListener('load', function () {
        try {
          navigator.serviceWorker
            .register('/apps/chitti/sw.js', { scope: '/apps/chitti/' })
            .catch(function () { /* silent: registration is best-effort */ });
        } catch (e) { /* silent */ }
      });
    }
  </script>

</Base>
