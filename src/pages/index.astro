---
import Base from "../layouts/Base.astro";
import LanguageStudy from "../components/LanguageStudy.astro";
import Mechanism from "../components/Mechanism.astro";
const tools = [
  {
    title: "Tokenizer Arena",
    text: "Compare the token IDs produced by five model vocabularies.",
    href: "/apps/tokenizer",
    kind: "Language",
  },
  {
    title: "PDF Lens",
    text: "Turn documents into text, chunks, and a token budget.",
    href: "/apps/pdf-lens",
    kind: "Documents",
  },
  {
    title: "Jev evaluation notebook",
    text: "Inspect typed judgments, prompt revisions, and agent traces.",
    href: "/apps/jev",
    kind: "Evaluation",
  },
  {
    title: "GGUF Inspect",
    text: "Inspect a model’s architecture before downloading its weights.",
    href: "/apps/gguf-inspect",
    kind: "Models",
  },
];
---

<Base
  wide
  title="Amaljith Kuttamath | AI agents and model experiments"
  description="Browser-based data agents, language model experiments, and interpretability research by Amaljith Kuttamath."
>
  <section class="experimental-opening">
    <div class="experimental-heading">
      <div class="opening-intro">
        <p class="opening-role">Amaljith Kuttamath · AI engineer</p>
        <h1>
          AI agents and
          <br />
          model experiments.
        </h1>
        <p>
          I build tools for retrieving data, evaluating model outputs, and
          inspecting language models. The projects below run in your browser.
        </p>
      </div>
      <div class="project-launcher" aria-label="Start with a project">
        <a href="/apps/chitti">
          <strong>Chitti</strong>
          <span>Analyze public data with citations.</span>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/apps/probability-xray">
          <strong>Probability X-ray</strong>
          <span>Inspect next-token probabilities.</span>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/radar">
          <strong>AI Radar</strong>
          <span>Browse AI papers, models, and code.</span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
    <LanguageStudy />
  </section>
  <section
    id="work"
    class="folio-section selected-work"
    aria-labelledby="selected-heading"
  >
    <div class="folio-section-head">
      <h2 id="selected-heading">Tools you can use</h2>
      <p>Browser-based tools</p>
    </div>
    <div class="selected-grid">
      <a class="project-lead" href="/apps/chitti">
        <div class="project-context">
          <span class="folio-label">Data &amp; verification</span>
          <span aria-hidden="true">↗</span>
        </div>
        <h3>Chitti</h3>
        <p class="project-question">Public-data analysis</p>
        <Mechanism kind="agent" />
        <p class="project-description">
          An agent that retrieves public data, computes, charts, and checks its
          answer. The sources and calculations stay inspectable.
        </p>
        <span class="project-action">Open Chitti</span>
      </a>
      <a class="project-side" href="/apps/probability-xray">
        <div class="project-context">
          <span class="folio-label">Model behavior</span>
          <span aria-hidden="true">↗</span>
        </div>
        <Mechanism kind="model" />
        <h3>Probability X-ray</h3>
        <p class="project-question">Next-token probabilities</p>
        <p class="project-description">
          Generate text with a local model and inspect the probability behind
          each token. Runs on WebGPU.
        </p>
        <span class="project-action">Open Probability X-ray</span>
      </a>
    </div>
    <div class="folio-rows">
      {tools.map((t) => (
        <a class="folio-row" href={t.href}>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
          <span>{t.kind} ↗</span>
        </a>
      ))}
    </div>
  </section>
  <section
    id="experiments"
    class="folio-section"
    aria-labelledby="experiments-heading"
  >
    <div class="folio-section-head">
      <h2 id="experiments-heading">Experiments</h2>
      <p>Training and interpretability</p>
    </div>
    <div class="folio-rows">
      <a class="folio-row" href="/lab/microgpt">
        <h3>microGPT Trainer</h3>
        <p>
          Train a tiny transformer. Watch its embeddings, attention, and loss
          change as it learns.
        </p>
        <span>Training ↗</span>
      </a>
      <a class="folio-row" href="/lab/watch-model-think">
        <h3>Watch a Model Think</h3>
        <p>
          Step through recorded GPT-2 runs and inspect the features beneath the
          generated text.
        </p>
        <span>Interpretability ↗</span>
      </a>
    </div>
  </section>
  <section class="radar-entry folio-section">
    <div>
      <span class="folio-label">Daily reading</span>
      <h2>AI Radar</h2>
      <p>
        A daily machine-generated briefing with source links, observation data,
        and an archive.
      </p>
    </div>
    <a class="folio-link" href="/radar">
      Read the latest briefing
    </a>
  </section>
</Base>
<style>
  .experimental-opening {
    padding: 24px 0 28px;
  }
  .experimental-heading {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-2xl);
    align-items: end;
    margin-bottom: 24px;
  }
  .experimental-heading h1 {
    font: 500 clamp(2.1rem, 3.8vw, 3.4rem)/1.05 var(--font-sans);
    letter-spacing: -0.055em;
    margin: 0;
  }
  .experimental-heading > div {
    padding-bottom: var(--space-sm);
    max-width: none;
    justify-self: stretch;
  }
  .experimental-heading p {
    color: var(--fg-muted);
    font-size: var(--text-body);
    line-height: 1.75;
    margin: 0 0 var(--space-lg);
  }
  .experimental-heading a {
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--line-strong);
  }
  .experimental-heading a span {
    margin-left: var(--space-md);
  }
  .experimental-heading a:hover {
    text-decoration-color: var(--fg);
  }
  .selected-work {
    margin-top: 0;
    scroll-margin-top: var(--space-xl);
  }
  .selected-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    margin: var(--space-xl) 0;
  }
  .project-lead,
  .project-side {
    padding: 0 0 var(--space-xl);
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration) var(--ease);
  }
  .project-lead {
    padding-right: var(--space-xl);
    border-right: 1px solid var(--fg-faint);
  }
  .project-lead:hover,
  .project-side:hover {
    border-bottom-color: var(--accent-color);
  }
  .project-context {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-lg);
  }
  .selected-grid h3 {
    font: 500 1rem var(--font-sans);
    margin: 0 0 var(--space-sm);
  }
  .project-question {
    font: 500 1.6rem/1.15 var(--font-serif);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-md);
  }
  .project-description {
    font-size: var(--text-small);
    color: var(--fg-muted);
    max-width: 48ch;
    margin: var(--space-md) 0 var(--space-lg);
  }
  .project-action {
    margin-top: auto;
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--line-strong);
  }
  .project-side :global(svg) {
    margin-bottom: var(--space-lg);
  }
  .selected-grid :global(svg) {
    max-height: 130px;
  }
  .radar-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    border-top: 1px solid var(--line-strong);
    padding: var(--space-xl) 0;
  }
  .radar-entry h2 {
    font-size: 2.5rem;
    margin: var(--space-sm) 0;
  }
  .radar-entry p {
    max-width: 55ch;
    color: var(--fg-muted);
    font-size: var(--text-body);
    margin: 0;
  }
  .radar-entry > a {
    flex: none;
  }
  @media (max-width: 760px) {
    .experimental-heading {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .experimental-heading > div {
      max-width: 50ch;
      justify-self: start;
    }
    .experimental-heading h1 {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .experimental-heading p {
      margin-bottom: var(--space-md);
    }
    .selected-grid {
      grid-template-columns: 1fr;
    }
    .project-lead {
      border-right: 0;
      padding-right: 0;
    }
    .project-question {
      font-size: 2.2rem;
    }
    .radar-entry {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-lg);
    }
  }
  .experimental-heading {
    align-items: center;
  }
  .experimental-heading .opening-intro p {
    max-width: 57ch;
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 14px 0 0;
  }
  .experimental-heading .opening-intro .opening-role {
    margin: 0 0 12px;
    font-size: 0.75rem;
  }
  .project-launcher {
    border-top: 1px solid var(--line-strong);
  }
  .experimental-heading .project-launcher a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    padding: 13px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .project-launcher a:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .project-launcher strong {
    font-size: 0.92rem;
    font-weight: 500;
  }
  .experimental-heading .project-launcher span {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.78rem;
    grid-column: 1;
  }
  .project-launcher b {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    font-weight: 400;
  }
  @media (max-width: 760px) {
    .experimental-heading > div {
      max-width: none;
      width: 100%;
    }
    .experimental-heading {
      gap: 20px;
    }
  }
</style>
