---
import Base from "../layouts/Base.astro";

const research = [
  {
    href: "https://github.com/amaljithkuttamath/trust-bench",
    title: "trust-bench",
    detail:
      "Interpretability toolkit probing SAE features, activations, and circuits in Llama 3.1 8B.",
  },
  {
    href: "https://github.com/amaljithkuttamath/jlens-replication",
    title: "jlens-replication",
    detail:
      "Replicating Anthropic's Jacobian lens on small open-weight models with free compute.",
  },
  {
    href: "https://github.com/amaljithkuttamath/sae-explorer",
    title: "sae-explorer",
    detail:
      "Investigating a Gemma 2 2B SAE feature associated with conjunctions across six languages.",
  },
  {
    href: "https://github.com/amaljithkuttamath/mlx-interp",
    title: "mlx-interp",
    detail:
      "Mechanistic interpretability tools for Apple MLX. Sparse autoencoders on Apple Silicon.",
  },
  {
    href: "https://github.com/amaljithkuttamath/autoresearch-mlx-qwen-3-5",
    title: "hybrid-attention-mlx",
    detail:
      "From-scratch MLX implementation of Qwen3.5 hybrid DeltaNet + full-attention architecture.",
  },
];
---

<Base
  wide
  title="About | Amaljith Kuttamath"
  description="Amaljith Kuttamath, AI engineer working on language model behavior, retrieval, evaluation, and mechanistic interpretability."
>
  <header class="about-opening folio-hero">
    <div>
      <p class="folio-label">A little background</p>
      <h1>
        I like knowing
        <br />
        why it works.
      </h1>
      <p class="folio-intro">
        I’m Amaljith Kuttamath. I build AI systems and tools for understanding
        them. The questions that stick with me tend to start where a
        good-looking answer stops.
      </p>
    </div>
    <figure>
      <img src="/amal.jpg" alt="Amaljith Kuttamath" width="360" height="420" />
      <figcaption>Amaljith Kuttamath / AI engineer</figcaption>
    </figure>
  </header>
  <section class="about-story">
    <h2>
      From physical systems
      <br />
      to model internals.
    </h2>
    <div>
      <p>
        I started at ISRO, then co-founded RadianArc, building digital twins for
        predictive maintenance on industrial machinery.
      </p>
      <p>
        Retrieval systems and knowledge graphs for healthcare pulled me toward a
        different kind of machinery: language models, the representations inside
        them, and the gap between a confident answer and a justified one.
      </p>
      <p>
        I completed an MS in Data Analytics at George Mason University, with a
        thesis on RAG systems for healthcare. The work here grows out of those
        questions: what a model sees, how its decisions behave, and how to make
        a system easier to inspect.
      </p>
      <a href="/resume.pdf" class="folio-link">
        Read my résumé
      </a>
    </div>
  </section>
  <section class="folio-section" aria-labelledby="research-title">
    <div class="folio-section-head">
      <h2 id="research-title">Threads I keep pulling</h2>
      <p>Research libraries &amp; replications</p>
    </div>
    <div class="folio-rows">
      {research.map((r) => (
        <a
          class="folio-row"
          href={r.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <h3>{r.title}</h3>
          <p>{r.detail}</p>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="about-record folio-section">
    <h2>A few points of reference</h2>
    <dl>
      <div>
        <dt>Education</dt>
        <dd>
          MS, Data Analytics
          <br />
          George Mason University
        </dd>
      </div>
      <div>
        <dt>Certification</dt>
        <dd>
          Google Cloud Professional
          <br />
          ML Engineer, 2024
        </dd>
      </div>
      <div>
        <dt>Publication</dt>
        <dd>
          <a
            href="https://doi.org/10.1097/QMH.0000000000000525"
            target="_blank"
            rel="noopener noreferrer"
          >
            Predicting Risk of Lung Cancer ↗
          </a>
          <br />
          Quality Management in Health Care
        </dd>
      </div>
    </dl>
  </section>
  <section id="work-together" class="about-end folio-section">
    <h2>
      Have a question
      <br />
      worth building for?
    </h2>
    <div>
      <p>
        I work on retrieval, evaluation, and model-backed products. We start
        with one concrete problem, agree on what success looks like, then build
        a working slice and test it.
      </p>
      <p>
        For a project, a research conversation, or a useful disagreement:
        <br />
        <a class="folio-link" href="mailto:kuttamath.amaljith@gmail.com">
          kuttamath.amaljith@gmail.com
        </a>
      </p>
      <a class="folio-link" href="/resume.pdf">
        Résumé
      </a>
    </div>
  </section>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      mainEntity: {
        "@type": "Person",
        name: "Amaljith Kuttamath",
        jobTitle: "AI Engineer",
        url: "https://amaljithkuttamath.github.io",
      },
    })}
  />
</Base>
<style>
  .about-opening {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr;
    gap: var(--space-3xl);
    align-items: center;
  }
  .about-opening .folio-label {
    margin-bottom: var(--space-lg);
  }
  .about-opening h1 {
    max-width: 15ch;
  }
  .about-opening figure {
    margin: 0;
  }
  .about-opening img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    object-position: center 30%;
    border-radius: var(--radius-md);
    filter: grayscale(1);
    border: 1px solid var(--fg-faint);
  }
  .about-opening figcaption {
    font: 0.6rem/1.6 var(--font-mono);
    color: var(--fg-muted);
    margin-top: var(--space-sm);
  }
  .about-story {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-2xl);
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-xl);
  }
  .about-story h2 {
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0;
  }
  .about-story p {
    color: var(--fg-muted);
    line-height: 1.85;
  }
  .about-record {
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-xl);
  }
  .about-record h2 {
    font-size: 2rem;
    margin: 0 0 var(--space-xl);
  }
  .about-record dl {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: var(--space-xl);
  }
  .about-record dt {
    font: var(--text-label) var(--font-mono);
    color: var(--fg-muted);
    margin-bottom: var(--space-md);
  }
  .about-record dd {
    font-size: var(--text-small);
    line-height: 1.8;
  }
  .about-record a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .about-end {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    border-top: 1px solid var(--line-strong);
    padding-top: var(--space-xl);
  }
  .about-end h2 {
    font-size: 2.6rem;
    line-height: 1.1;
    margin: 0;
  }
  .about-end p {
    color: var(--fg-muted);
    align-self: center;
    font-size: var(--text-small);
  }
  .about-end a {
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .about-opening,
    .about-story,
    .about-end {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .about-opening figure {
      max-width: 320px;
    }
    .about-record dl {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
