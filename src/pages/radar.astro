---
import Base from "../layouts/Base.astro";
import SignalDesk from "../components/SignalDesk.astro";
---

<Base
  wide
  title="AI Radar | Amaljith Kuttamath"
  description="A daily AI research briefing and the ranked sources behind it. Read the overview, inspect the evidence, and explore earlier editions."
>
  <div class="radar-page">
    <header class="radar-opening">
      <div>
        <p class="folio-label">Daily AI research feed</p>
        <h1>AI Radar</h1>
        <p>
          AI papers, models, and code. Inspect the sources, then read the daily
          synthesis.
        </p>
      </div>
      <div class="radar-edition">
        <span class="radar-status" id="radar-status">
          Reading publication…
        </span>
        <time id="radar-date">Latest edition</time>
        <a href="#briefing" id="jump-briefing">
          Read daily briefing ↓
        </a>
        <a
          href="https://github.com/amaljithkuttamath/ai-radar"
          target="_blank"
          rel="noopener noreferrer"
        >
          Sources &amp; method ↗
        </a>
      </div>
    </header>
    <SignalDesk />
    <div class="radar-navigation">
      <div class="radar-tabs" role="tablist" aria-label="Radar view">
        <button
          id="tab-briefing"
          role="tab"
          aria-selected="true"
          aria-controls="panel-briefing"
          data-view="briefing"
        >
          Briefing
        </button>
        <button
          id="tab-evidence"
          role="tab"
          aria-selected="false"
          aria-controls="panel-evidence"
          tabindex="-1"
          data-view="evidence"
        >
          Evidence <span id="evidence-count"></span>
        </button>
        <button
          id="tab-archive"
          role="tab"
          aria-selected="false"
          aria-controls="panel-archive"
          tabindex="-1"
          data-view="archive"
        >
          Archive
        </button>
        <button
          id="radar-refresh"
          class="radar-refresh"
          aria-label="Refresh Radar"
        >
          ↻
        </button>
      </div>
      <nav
        id="radar-timeline"
        class="radar-timeline"
        aria-label="Daily edition timeline"
      >
        <span>Loading timeline…</span>
      </nav>
    </div>
    <section id="panel-briefing" role="tabpanel" aria-labelledby="tab-briefing">
      <div id="radar-brief" aria-live="polite">
        <p class="radar-loading">Opening the published briefing…</p>
      </div>
    </section>
    <section
      id="panel-evidence"
      role="tabpanel"
      aria-labelledby="tab-evidence"
      hidden
    >
      <div class="evidence-heading">
        <div>
          <h2>Source observations</h2>
          <p>
            Observed items, ranked by the pipeline’s five evidence criteria. A
            score is a selection signal, not a verdict on quality.
          </p>
        </div>
        <div class="evidence-search">
          <label for="evidence-search">Find an item</label>
          <input
            id="evidence-search"
            type="search"
            placeholder="Search papers, models, repos…"
          />
        </div>
      </div>
      <div class="evidence-controls">
        <div
          id="source-filters"
          role="group"
          aria-label="Filter by source"
        ></div>
        <label>
          Sort{" "}
          <select id="evidence-sort">
            <option value="score">Top rated</option>
            <option value="newest">First seen, newest</option>
          </select>
        </label>
        <label>
          Score{" "}
          <select id="minimum-score">
            <option value="0">All scores</option>
            <option value="3">3 or higher</option>
            <option value="4">4 or higher</option>
          </select>
        </label>
      </div>
      <p id="evidence-result" class="radar-meta" role="status"></p>
      <div id="evidence-list">
        <p class="radar-loading">Reading the evidence index…</p>
      </div>
      <button id="evidence-more" class="radar-more" hidden>
        Show more
      </button>
    </section>
    <section
      id="panel-archive"
      role="tabpanel"
      aria-labelledby="tab-archive"
      hidden
    >
      <div class="evidence-heading">
        <div>
          <h2>Earlier editions</h2>
          <p>Browse by month, date, or topic.</p>
        </div>
        <div class="evidence-search">
          <label for="archive-search">Find an edition</label>
          <input
            id="archive-search"
            type="search"
            placeholder="Search a date or topic…"
          />
        </div>
      </div>
      <div
        id="archive-months"
        class="archive-months"
        role="group"
        aria-label="Browse editions by month"
      ></div>
      <p id="archive-result" class="radar-meta" role="status"></p>
      <div id="archive-list">
        <p class="radar-loading">Reading the archive…</p>
      </div>
    </section>
    <noscript>
      <p>
        JavaScript loads the current research data.{" "}
        <a href="https://github.com/amaljithkuttamath/ai-radar/blob/main/reports/latest.md">
          Read the published Markdown
        </a>
        .
      </p>
    </noscript>
  </div>
  <script>
    import { bootRadar } from "../lib/radar/boot";
    bootRadar();
  </script>
</Base>
<style is:global>
  .radar-page {
    --radar-line: var(--line-strong);
  }
  .radar-opening {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-xl);
    padding: 24px 0;
  }
  .radar-opening h1 {
    font: 500 clamp(2rem, 3.4vw, 3.1rem)/1 var(--font-sans);
    line-height: 1;
    letter-spacing: -0.045em;
    margin: var(--space-md) 0;
  }
  .radar-opening p:not(.folio-label) {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.6;
  }
  .radar-edition {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
    font-size: var(--text-small);
  }
  .radar-edition time {
    font: 1.2rem var(--font-serif);
  }
  .radar-edition a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .radar-edition a:hover {
    color: var(--fg);
  }
  .radar-status {
    font: var(--text-tag) var(--font-mono);
    color: var(--fg-muted);
  }
  .radar-status[data-current="true"]::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    margin-right: var(--space-sm);
  }
  .radar-navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--radar-line);
    margin-bottom: var(--space-xl);
  }
  .radar-timeline {
    padding: 0;
    margin: 0;
    border: 0;
    flex-direction: row;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .radar-timeline span {
    font: 0.65rem var(--font-mono);
    color: var(--fg-muted);
    margin-right: 4px;
  }
  .radar-timeline a,
  .radar-timeline button {
    font: 0.65rem var(--font-mono);
    color: var(--fg-muted);
    background: none;
    border: 0;
    padding: 12px 2px;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }
  .radar-timeline a {
    border-bottom: 2px solid var(--line-strong);
  }
  .radar-timeline a[aria-current] {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
  .radar-timeline a:hover,
  .radar-timeline button:hover {
    color: var(--fg);
  }
  .radar-timeline button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  @media (max-width: 980px) {
    .radar-navigation {
      flex-wrap: wrap;
      gap: 0;
    }
    .radar-tabs {
      width: 100%;
    }
    .radar-timeline {
      width: 100%;
      justify-content: space-between;
      padding-bottom: 6px;
      gap: 4px;
    }
    .radar-timeline span {
      font-size: 0.6rem;
    }
    .radar-timeline a,
    .radar-timeline button {
      font-size: 0.6rem;
    }
  }
  .radar-tabs {
    display: flex;
    gap: var(--space-xl);
  }
  .radar-tabs button {
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--fg-muted);
    font: var(--text-body) var(--font-sans);
    padding: var(--space-md) 0;
    cursor: pointer;
  }
  .radar-tabs button:hover {
    color: var(--fg);
  }
  .radar-tabs button[aria-selected="true"] {
    border-bottom-color: var(--fg);
    color: var(--fg);
  }
  .radar-tabs button span {
    font: var(--text-tag) var(--font-mono);
    margin-left: var(--space-sm);
  }
  .radar-tabs .radar-refresh {
    margin-left: auto;
    font-size: 1.5rem;
    min-width: 40px;
  }
  .radar-page [hidden] {
    display: none !important;
  }
  .radar-loading {
    color: var(--fg-muted);
    padding: var(--space-xl) 0;
  }
  .radar-error {
    padding: var(--space-lg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
  }
  .radar-error p {
    color: var(--fg-muted);
  }
  .radar-error button {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--fg-faint);
    background: var(--bg-hover);
    color: var(--fg);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .brief-overview {
    display: grid;
    grid-template-columns: 1fr 210px;
    gap: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--radar-line);
  }
  .brief-overview h2 {
    font: var(--text-label) var(--font-mono);
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    margin: 0 0 var(--space-lg);
  }
  .brief-lead {
    font: 1.15rem/1.65 var(--font-serif);
    letter-spacing: -0.015em;
    max-width: 72ch;
  }
  .brief-overview aside {
    border-left: 1px solid var(--fg-faint);
    padding-left: var(--space-lg);
  }
  .brief-overview aside p {
    font-size: var(--text-small);
    color: var(--fg-muted);
    margin: var(--space-sm) 0 var(--space-lg);
  }
  .brief-overview aside a {
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .radar-meta {
    color: var(--fg-muted);
    font: var(--text-tag)/1.7 var(--font-mono);
  }
  .radar-notice {
    padding: var(--space-md);
    border-left: 2px solid var(--signal);
    background: var(--bg-elevated);
    font-size: var(--text-small);
    margin-bottom: var(--space-lg);
  }
  .radar-picks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    margin: var(--space-xl) 0;
  }
  .radar-pick {
    border-top: 1px solid var(--radar-line);
    padding-top: var(--space-lg);
  }
  .radar-pick h3 {
    font: 500 1.25rem/1.3 var(--font-serif);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-md);
  }
  .radar-pick h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .radar-pick p {
    color: var(--fg-muted);
    font-size: var(--text-small);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .radar-reading-title {
    font-size: 1.5rem;
    margin: var(--space-xl) 0 var(--space-lg);
  }
  .radar-actions {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: var(--space-2xl);
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--radar-line);
  }
  .radar-actions h2 {
    font-size: 1.5rem;
    margin: 0;
  }
  .radar-actions li {
    margin: 0 0 var(--space-md) var(--space-lg);
    color: var(--fg-muted);
    font-size: var(--text-body);
  }
  .radar-actions a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .radar-full {
    border-top: 1px solid var(--radar-line);
    border-bottom: 1px solid var(--radar-line);
    margin: var(--space-lg) 0;
  }
  .radar-full summary {
    padding: var(--space-lg) 0;
    cursor: pointer;
    font-size: var(--text-body);
  }
  .radar-full summary span {
    color: var(--fg-muted);
    font-size: var(--text-small);
    margin-left: var(--space-md);
  }
  .radar-prose {
    max-width: 72ch;
    font-size: 1rem;
    line-height: 1.85;
    padding: var(--space-md) 0 var(--space-xl);
  }
  .radar-prose p,
  .radar-prose li {
    color: var(--fg-muted);
  }
  .radar-prose strong {
    color: var(--fg);
  }
  .radar-prose h2 {
    font: 500 1.8rem var(--font-serif);
    margin: var(--space-xl) 0 var(--space-lg);
  }
  .radar-prose h3 {
    font: 500 1rem var(--font-sans);
    margin: var(--space-xl) 0 var(--space-md);
  }
  .radar-prose a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .radar-prose ul,
  .radar-prose ol {
    padding-left: var(--space-lg);
  }
  .radar-prose li {
    margin-bottom: var(--space-sm);
  }
  .radar-prose pre,
  .radar-prose table {
    display: block;
    overflow: auto;
    max-width: 100%;
  }
  .radar-prose blockquote {
    border-left: 2px solid var(--signal);
    padding-left: var(--space-lg);
  }
  .radar-prose :is(p, li) {
    overflow-wrap: anywhere;
  }
  .evidence-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xl);
    align-items: flex-end;
    margin-bottom: var(--space-xl);
  }
  .evidence-heading h2 {
    font-size: 2rem;
    margin: 0 0 var(--space-sm);
  }
  .evidence-heading p {
    color: var(--fg-muted);
    font-size: var(--text-small);
    max-width: 65ch;
    margin: 0;
  }
  .evidence-search {
    flex: none;
  }
  .evidence-search label {
    display: block;
    font: var(--text-tag) var(--font-mono);
    color: var(--fg-muted);
    margin-bottom: var(--space-sm);
  }
  .evidence-search input {
    width: 280px;
    max-width: 100%;
    padding: 0.7rem var(--space-md);
    background: var(--bg-elevated);
    border: 1px solid var(--radar-line);
    border-radius: var(--radius-sm);
    font: var(--text-small) var(--font-sans);
    color: var(--fg);
  }
  .evidence-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .evidence-controls #source-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-right: auto;
  }
  .evidence-controls button {
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--fg-muted);
    padding: var(--space-sm) 0.65rem;
    font: var(--text-small) var(--font-sans);
    cursor: pointer;
  }
  .evidence-controls button[aria-pressed="true"] {
    border-color: var(--radar-line);
    background: var(--bg-hover);
    color: var(--fg);
  }
  .evidence-controls button:hover {
    color: var(--fg);
  }
  .evidence-controls label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-small);
    color: var(--fg-muted);
  }
  .evidence-controls select {
    background: var(--bg);
    color: var(--fg);
    font: var(--text-small) var(--font-sans);
    border: 1px solid var(--fg-faint);
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
  }
  .evidence-controls input {
    accent-color: var(--fg);
  }
  .evidence-row {
    display: grid;
    grid-template-columns: 50px 1fr 120px;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--fg-faint);
    align-items: baseline;
  }
  .evidence-row:hover {
    border-color: var(--fg);
  }
  .evidence-score {
    font: 1.3rem var(--font-serif);
  }
  .evidence-score small {
    font: var(--text-tag) var(--font-mono);
    color: var(--fg-muted);
  }
  .evidence-row h3 {
    font: 500 1rem/1.5 var(--font-sans);
    margin: 0 0 var(--space-xs);
  }
  .evidence-row p {
    font: var(--text-tag) var(--font-mono);
    color: var(--fg-muted);
    margin: 0;
  }
  .evidence-row time {
    color: var(--fg-muted);
    text-align: right;
    font: var(--text-tag) var(--font-mono);
  }
  .radar-more {
    display: block;
    margin: var(--space-xl) auto;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--radar-line);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    color: var(--fg);
    font: var(--text-small) var(--font-sans);
    cursor: pointer;
  }
  .archive-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: var(--space-xl);
    width: 100%;
    text-align: left;
    color: var(--fg);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--fg-faint);
    padding: var(--space-lg) 0;
    cursor: pointer;
  }
  .archive-row:hover {
    border-color: var(--fg);
  }
  .archive-row time {
    font: var(--text-label) var(--font-mono);
    color: var(--fg-muted);
  }
  .archive-row p {
    font: var(--text-body)/1.7 var(--font-serif);
    margin: 0;
  }
  .radar-back {
    border: 0;
    background: none;
    color: var(--fg);
    font: var(--text-small) var(--font-sans);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    margin-bottom: var(--space-lg);
  }
  @media (max-width: 760px) {
    .radar-opening {
      align-items: flex-start;
      padding-top: var(--space-xl);
    }
    .radar-edition {
      max-width: 160px;
      text-align: right;
    }
    .brief-overview {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .brief-overview aside {
      border-left: 0;
      border-top: 1px solid var(--fg-faint);
      padding: var(--space-md) 0 0;
    }
    .brief-overview aside p {
      display: inline;
      margin-right: var(--space-md);
    }
    .radar-picks {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    .radar-pick h3 {
      font-size: 1.4rem;
    }
    .radar-actions {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .evidence-heading {
      flex-direction: column;
      align-items: stretch;
    }
    .evidence-search input {
      width: 100%;
    }
    .evidence-row {
      grid-template-columns: 36px 1fr;
      gap: var(--space-md);
    }
    .evidence-row time {
      grid-column: 2;
      text-align: left;
    }
    .archive-row {
      grid-template-columns: 1fr auto;
      gap: var(--space-sm);
    }
    .archive-row p {
      grid-column: 1;
    }
    .archive-row > span {
      grid-column: 2;
      grid-row: 1;
    }
  }
  @media (max-width: 440px) {
    .radar-opening {
      flex-direction: column;
      gap: var(--space-lg);
    }
    .radar-edition {
      align-items: flex-start;
      max-width: none;
      text-align: left;
    }
    .radar-opening p br {
      display: none;
    }
    .radar-tabs {
      gap: var(--space-lg);
    }
    .radar-tabs button {
      font-size: var(--text-small);
    }
  }
  .archive-months {
    display: flex;
    gap: 6px;
    margin: 20px 0;
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .archive-months button {
    flex: 1;
    min-width: 90px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 12px;
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--fg-muted);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font: 0.7rem var(--font-mono);
  }
  .archive-months button::before {
    content: "";
    width: var(--edition-width);
    height: 4px;
    background: currentColor;
    min-width: 2px;
  }
  .archive-months button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
  }
  .archive-months button:hover {
    border-color: var(--fg);
  }
  .radar-opening > div:first-child {
    max-width: 65ch;
  }
  .radar-opening h1 {
    margin: 8px 0 12px;
  }
  .radar-opening .folio-label {
    margin: 0;
  }
  @media (max-width: 700px) {
    .radar-edition {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 16px;
    }
    .radar-edition time {
      font-size: 1rem;
    }
    .radar-opening {
      gap: 16px;
    }
  }
</style>
