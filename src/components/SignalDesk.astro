<section class="signal-desk" aria-labelledby="signal-title">
  <div class="signal-topline">
    <h2 id="signal-title">Research threads</h2>
    <div class="signal-view-switch" role="group" aria-label="Research view">
      <button type="button" data-signal-view="evolution" aria-pressed="true">
        Evolution
      </button>
      <button
        type="button"
        data-signal-view="observations"
        aria-pressed="false"
      >
        Observations
      </button>
    </div>
    <span id="signal-total" hidden>
      Loading observations…
    </span>
  </div>
  <div id="evolution-workspace">
    <p class="signal-wait">Reading research changes…</p>
  </div>
  <div id="signal-workspace" hidden>
    <p class="signal-wait">Loading the published observations…</p>
  </div>
</section>
